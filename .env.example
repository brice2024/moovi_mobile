# Exemple de configuration d'environnement pour Moovi API.
# Générer deux clés longues et aléatoires et ne jamais versionner le vrai .env.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# Base de données MySQL
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=moovi_bd
DATABASE_URL=

# Stockage local des fichiers (remplace Firebase Storage)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16

# Authentification OTP / WhatsApp via WAHA
OTP_EXPIRATION_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_RETURN_CODE=false
SMS_PROVIDER=waha
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TIMEOUT_SECONDS=10

# Règles métier VTC Moovi
COMMISSION_RATE=0.15
MIN_RIDE_PRICE=500
MAX_RIDE_PRICE=50000
PRICE_STEP=250
DEFAULT_SEARCH_RADIUS_KM=6.0
DEFAULT_WALLET_BALANCE=5000.0
RIDE_SEARCH_TIMEOUT_SECONDS=300
DRIVER_DISCONNECT_GRACE_SECONDS=30
BACKGROUND_TASK_INTERVAL_SECONDS=5
BACKGROUND_JOBS_ENABLED=true
PROMO_DISCOUNT_XAF=500
REFERRAL_REWARD_XAF=500
REQUIRE_DRIVER_VERIFICATION=true

# Intégrations externes (clés stockées uniquement côté serveur)
GOOGLE_MAPS_API_KEY=
# Clé du SDK Google Maps natif de l'app mobile : injectée au build Android par Gradle
# (android/app/build.gradle.kts lit ce fichier). Restreindre au package + SHA-1.
GOOGLE_MAPS_MOBILE_API_KEY=
PAWAPAY_TOKEN=replace-with-your-pawapay-server-token
PAWAPAY_WEBHOOK_SECRET=
PAWAPAY_PRODUCTION=false
PAWAPAY_SIMULATE=true
CORS_ORIGINS=*

# Les signatures acceptées sont des HMAC-SHA256 hexadécimaux du corps brut,
# envoyés dans X-PawaPay-Signature (préfixe sha256= facultatif).
# Sans secret webhook, les transactions réelles sont vérifiées auprès du fournisseur.
# En production : APP_ENV=production, REQUIRE_DRIVER_VERIFICATION=true,
# OTP_DEBUG_RETURN_CODE=false. Renseigner les clés providers et désactiver
# la simulation avant d'accepter des paiements réels.
# En multi-worker, définir RATELIMIT_STORAGE_URI sur un Redis partagé.

# Sécurité / exploitation
# FLASK_DEBUG=true active le débogueur Werkzeug : jamais sur un serveur joignable.
FLASK_DEBUG=false
LOG_LEVEL=INFO
# Derrière nginx/Caddy : true pour lire l'IP réelle (limites de requêtes par IP)
TRUST_PROXY=false
# Adresse publique de l'API pour les URL de fichiers (vide = hôte de la requête)
PUBLIC_BASE_URL=
LOG_FOLDER=logs
# Plusieurs processus serveur : file partagée Socket.IO + limites de requêtes
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Écran « Assistance » de l'application (laisser vide pour masquer)
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
